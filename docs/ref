/** Immediate-format base class. Subclasses know how to extract their minimal bit-field from a
 *  raw instruction (minBitsFromInstr) and sign/zero-extend it to 32 bits (do_toImm32).
 */
abstract class Imm(val len: Int) {
  def toImm32(minBits: UInt): UInt = do_toImm32(minBits(len - 1, 0))
  def do_toImm32(minBits: UInt): UInt
  def minBitsFromInstr(instr: UInt): UInt
}

case class Imm_I() extends Imm(12) {
  override def do_toImm32(minBits: UInt): UInt = SignExt(minBits(len - 1, 0), 32)
  override def minBitsFromInstr(instr: UInt): UInt = Cat(instr(31, 20))
}

case class Imm_S() extends Imm(12) {
  override def do_toImm32(minBits: UInt): UInt = SignExt(minBits, 32)
  override def minBitsFromInstr(instr: UInt): UInt = Cat(instr(31, 25), instr(11, 7))
}

case class Imm_B() extends Imm(12) {
  override def do_toImm32(minBits: UInt): UInt = SignExt(Cat(minBits, 0.U(1.W)), 32)
  override def minBitsFromInstr(instr: UInt): UInt = Cat(instr(31), instr(7), instr(30, 25), instr(11, 8))
}

case class Imm_U() extends Imm(20) {
  override def do_toImm32(minBits: UInt): UInt = Cat(minBits(len - 1, 0), 0.U(12.W))
  override def minBitsFromInstr(instr: UInt): UInt = instr(31, 12)
}

case class Imm_J() extends Imm(20) {
  override def do_toImm32(minBits: UInt): UInt = SignExt(Cat(minBits, 0.U(1.W)), 32)
  override def minBitsFromInstr(instr: UInt): UInt = Cat(instr(31), instr(19, 12), instr(20), instr(30, 25), instr(24, 21))
}

case class Imm_Z() extends Imm(22) {
  override def do_toImm32(minBits: UInt): UInt = minBits
  override def minBitsFromInstr(instr: UInt): UInt = Cat(instr(11, 7), instr(19, 15), instr(31, 20))

  def getCSRAddr(imm: UInt): UInt = {
    require(imm.getWidth == this.len)
    imm(11, 0)
  }

  def getRS1(imm: UInt): UInt = {
    require(imm.getWidth == this.len)
    imm(16, 12)
  }

  def getRD(imm: UInt): UInt = {
    require(imm.getWidth == this.len)
    imm(21, 17)
  }

  def getImm5(imm: UInt): UInt = {
    require(imm.getWidth == this.len)
    imm(16, 12)
  }
}

case class Imm_B6() extends Imm(6) {
  override def do_toImm32(minBits: UInt): UInt = ZeroExt(minBits, 32)
  override def minBitsFromInstr(instr: UInt): UInt = instr(25, 20)
}

case class Imm_OPIVIS() extends Imm(5) {
  override def do_toImm32(minBits: UInt): UInt = SignExt(minBits, 32)
  override def minBitsFromInstr(instr: UInt): UInt = instr(19, 15)
}

case class Imm_OPIVIU() extends Imm(5) {
  override def do_toImm32(minBits: UInt): UInt = ZeroExt(minBits, 32)
  override def minBitsFromInstr(instr: UInt): UInt = instr(19, 15)
}

case class Imm_VSETVLI() extends Imm(11) {
  override def do_toImm32(minBits: UInt): UInt = SignExt(minBits, 32)
  override def minBitsFromInstr(instr: UInt): UInt = instr(30, 20)

  def getVType(extedImm: UInt): InstVType = {
    val vtype = Wire(new InstVType)
    vtype := extedImm(10, 0).asTypeOf(new InstVType)
    vtype
  }
}

case class Imm_VSETIVLI() extends Imm(15) {
  override def do_toImm32(minBits: UInt): UInt = SignExt(minBits, 32)
  override def minBitsFromInstr(instr: UInt): UInt = {
    val rvInst: XSInstBitFields = instr.asTypeOf(new XSInstBitFields)
    val uimm5                   = rvInst.UIMM_VSETIVLI
    val vtype8                  = rvInst.ZIMM_VSETIVLI
    Cat(uimm5, vtype8)
  }

  def getVType(extedImm: UInt): InstVType = {
    val vtype = Wire(new InstVType)
    vtype := extedImm(9, 0).asTypeOf(new InstVType)
    vtype
  }

  def getAvl(extedImm: UInt): UInt = {
    extedImm(14, 10)
  }
}

case class Imm_VRORVI() extends Imm(6) {
  override def do_toImm32(minBits: UInt): UInt = ZeroExt(minBits, 32)
  override def minBitsFromInstr(instr: UInt): UInt = Cat(instr(26), instr(19, 15))
}

// ImmUnion aggregates all supported immediate formats and associates each with the SelImm
// encoding produced by the decode table. DecodedInst.imm is packed using immSelMap.
object ImmUnion {
  val I        = Imm_I()
  val S        = Imm_S()
  val B        = Imm_B()
  val U        = Imm_U()
  val J        = Imm_J()
  val Z        = Imm_Z()
  val OPIVIS   = Imm_OPIVIS()
  val OPIVIU   = Imm_OPIVIU()
  val VSETVLI  = Imm_VSETVLI()
  val VSETIVLI = Imm_VSETIVLI()
  val VRORVI   = Imm_VRORVI()

  val imms      = Seq(I, S, B, U, J, Z, OPIVIS, OPIVIU, VSETVLI, VSETIVLI, VRORVI)
  val maxLen    = imms.maxBy(_.len).len
  val immSelMap = Seq(
    SelImm.IMM_I,
    SelImm.IMM_S,
    SelImm.IMM_SB,
    SelImm.IMM_U,
    SelImm.IMM_UJ,
    SelImm.IMM_Z,
    SelImm.IMM_OPIVIS,
    SelImm.IMM_OPIVIU,
    SelImm.IMM_VSETVLI,
    SelImm.IMM_VSETIVLI,
    SelImm.IMM_VRORVI
  ).zip(imms)
}

// DecodeTable concatenates all sub-tables into the single ListLookup that DecodeUnit drives.
// Column layout must match DecodedInst.allSignals.
object DecodeTable {
  val default: List[BitPat] = XDecode.decodeDefault

  val table: Array[(BitPat, List[BitPat])] =
    XDecode.table ++
      FpDecode.table ++
      BitmanipDecode.table ++
      XSTrapDecode.table ++
      VecDecoder.table ++
      ZicondDecode.table

  require(table.forall(_._2.length == default.length), "Decode tables have different column size")
}