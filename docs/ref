/** Shared base trait for every sub-decode table. Provides the common encoding constants and
 *  the fallback decodeDefault entry (illegal-instruction fields).
 */
abstract trait DecodeConstants {
  def X = BitPat("b0")
  def N = BitPat("b0")
  def Y = BitPat("b1")
  def T = true
  def F = false

  def decodeDefault: List[BitPat] =
    //              srcType(0) srcType(1) fuType    fuOpType  rfWen
    //   |          |          |         |           |        |  fpWen
    //   |          |          |         |           |        |  |  isXSTrap
    //   |          |          |         |           |        |  |  |  flushPipe
    //   |          |          |         |           |        |  |  |  |  isRTS
    //   |          |          |         |           |        |  |  |  |  |  selImm
    List(SrcType.X, SrcType.X, FuType.X, FuOpType.X, N, N, N, N, N, SelImm.INVALID_INSTR) // The default output now keeps only fields still consumed by DecodedInst.

  val decodeArray: Array[(BitPat, XSDecodeBase)]
  final def table: Array[(BitPat, List[BitPat])] = decodeArray.map(x => (x._1, x._2.generate()))
}

/** Base class of one decode-table row. Each concrete subclass emits the BitPat List that
 *  becomes the ListLookup output for DecodedInst.
 */
abstract class XSDecodeBase {
  def X = BitPat("b?")
  def N = BitPat("b0")
  def Y = BitPat("b1")
  def T = true
  def F = false
  def generate(): List[BitPat]
}

// XSDecode is the primary decode-row constructor. Fields mirror DecodedInst's allSignals list
// and become the per-instruction BitPat sequence the decode table returns.
case class XSDecode(
  src1: BitPat,
  src2: BitPat,
  fu: FuType.Value,
  fuOp: BitPat,
  selImm: BitPat,
  xWen: Boolean = false,      // Scalar integer writeback enable.
  fWen: Boolean = false,      // Scalar floating-point writeback enable.
  xsTrap: Boolean = false,    // XSTrap instruction marker.
  flushPipe: Boolean = false, // Pipeline-flush request marker.
  isRTS: Boolean = true       // RTS-extension semantic marker.
) extends XSDecodeBase {
  def generate(): List[BitPat] = {
    List(
      src1,                            // Source-operand 0 type output.
      src2,                            // Source-operand 1 type output.
      BitPat(fu.id.U(FuType.width.W)), // Functional-unit type output.
      fuOp,                            // Functional-unit operation encoding output.
      xWen.B,                          // Integer write-enable output.
      fWen.B,                          // Floating-point write-enable output.
      xsTrap.B,                        // XSTrap marker output.
      flushPipe.B,                     // Pipeline-flush marker output.
      isRTS.B,                         // RTS semantic marker output.
      selImm                           // Immediate-selection output.
    )
  }
}

// FDecode is a thin wrapper over XSDecode for FP-family rows; it keeps SelImm optional and
// defaults isRTS to false so that pure F/D instructions do not pull RTS semantics by default.
case class FDecode(
  src1: BitPat,
  src2: BitPat,
  fu: FuType.Value,
  fuOp: BitPat,
  selImm: BitPat = SelImm.X,
  xWen: Boolean = false,      // Scalar integer writeback enable.
  fWen: Boolean = false,      // Scalar floating-point writeback enable.
  xsTrap: Boolean = false,    // XSTrap instruction marker.
  flushPipe: Boolean = false, // Pipeline-flush request marker.
  isRTS: Boolean = false      // RTS-extension semantic marker.
) extends XSDecodeBase {
  def generate(): List[BitPat] = {
    XSDecode(src1, src2, fu, fuOp, selImm, xWen, fWen, xsTrap, flushPipe, isRTS).generate() // Floating-style entries reuse the trimmed XSDecode output format.
  }
}

